# API
API_PORT=3001
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=crossval_session
SESSION_TTL_SECONDS=604800
REGISTRATION_ENABLED=true
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=crossval_development
MONGODB_MAX_POOL_SIZE=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Optional Atlas integration-test override. Tests always use and drop a unique *_test database.
# MONGODB_TEST_URI=mongodb+srv://<test-username>:<test-password>@<test-cluster-host>/?retryWrites=true&w=majority

# Web
NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_INTERNAL_URL=http://127.0.0.1:3001
